TEAM_ID=

PRODUCT_NAME=Walletka
APP_BUNDLE_IDENTIFIER=cz.poqet.walletka.Walletka$(TEAM_ID)
PRODUCT_BUNDLE_IDENTIFIER=$(APP_BUNDLE_IDENTIFIER)
// Shared container between the app and the share extension.
APP_GROUP_IDENTIFIER=group.$(APP_BUNDLE_IDENTIFIER)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Walletka pass service (passService/, a Cloudflare Worker) that signs Apple Wallet passes with the Pass Type ID
// certificate. e.g. https:/$()/walletka-pass-service.<account>.workers.dev  ("/$()/" keeps "//" from being a comment)
WALLETKA_SERVICE_URL=
// Must match the Worker's API_KEY secret.
WALLETKA_SERVICE_API_KEY=
