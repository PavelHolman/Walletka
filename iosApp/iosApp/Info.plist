<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Walletka uses the camera to photograph cards and their codes.</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>WalletkaAppGroup</key>
	<string>$(APP_GROUP_IDENTIFIER)</string>
	<key>WalletkaOrganizationName</key>
	<string>Walletka</string>
	<key>WalletkaServiceURL</key>
	<string>$(WALLETKA_SERVICE_URL)</string>
	<key>WalletkaServiceAPIKey</key>
	<string>$(WALLETKA_SERVICE_API_KEY)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(APP_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>walletka</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
