{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ can't hold some of these characters. Try QR code instead." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ neumí zapsat některé z těchto znaků. Zkuste raději QR kód."
          }
        }
      }
    },
    "%@ codes contain digits only." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kódy %@ obsahují jen číslice."
          }
        }
      }
    },
    "%@ codes have an even number of digits." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kódy %@ mají sudý počet číslic."
          }
        }
      }
    },
    "%@ holds only capital letters, digits, spaces and - . $ / + %%." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ umí jen velká písmena, číslice, mezery a - . $ / + %%."
          }
        }
      }
    },
